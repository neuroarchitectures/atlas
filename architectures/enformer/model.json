{
  "spec_version": "0.1",
  "id": "enformer",
  "name": "Enformer",
  "description": "Transformer-based model for predicting gene expression from DNA sequences with long-range context.",
  "category": "Audio",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "DNA Sequence",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          196608,
          4
        ]
      },
      "inputs": [],
      "outputs": [
        "conv-1"
      ]
    },
    {
      "id": "conv-1",
      "type": "conv1d",
      "name": "Conv Block",
      "position": {
        "x": 200,
        "y": 200
      },
      "params": {
        "outChannels": 1536,
        "kernelSize": 15,
        "stride": 1
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "pool-1"
      ],
      "scope": "model"
    },
    {
      "id": "pool-1",
      "type": "maxpool1d",
      "name": "Pooling",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "kernelSize": 2
      },
      "inputs": [
        "conv-1"
      ],
      "outputs": [
        "conv-2"
      ],
      "scope": "model"
    },
    {
      "id": "conv-2",
      "type": "conv1d",
      "name": "Conv Block",
      "position": {
        "x": 200,
        "y": 500
      },
      "params": {
        "outChannels": 3072,
        "kernelSize": 5,
        "stride": 1
      },
      "inputs": [
        "pool-1"
      ],
      "outputs": [
        "pool-2"
      ],
      "scope": "model"
    },
    {
      "id": "pool-2",
      "type": "maxpool1d",
      "name": "Pooling",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "kernelSize": 2
      },
      "inputs": [
        "conv-2"
      ],
      "outputs": [
        "tfmr-1"
      ],
      "scope": "model"
    },
    {
