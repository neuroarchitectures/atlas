      "inputs": [
        "pool-2"
      ],
      "outputs": [
        "linear-1"
      ],
      "scope": "model"
    },
    {
      "id": "linear-1",
      "type": "linear",
      "name": "Output Head",
      "position": {
        "x": 200,
        "y": 950
      },
      "params": {
        "outFeatures": 164,
        "inFeatures": 3072
      },
      "inputs": [
        "tfmr-1"
      ],
      "outputs": [
        "output-1"
      ],
      "scope": "model"
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Gene Expression",
      "position": {
        "x": 200,
        "y": 1100
      },
      "params": {},
      "inputs": [
        "linear-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "conv-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "conv-1",
      "to": "pool-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "pool-1",
      "to": "conv-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
