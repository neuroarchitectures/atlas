{
  "spec_version": "0.1",
  "id": "latent-diffusion",
  "name": "Latent Diffusion",
  "description": "Latent Diffusion Models: perform diffusion in a compressed latent space via a pretrained VAE autoencoder, enabling high-resolution image generation efficiently.",
  "category": "Generative",
  "components": [
    {
      "id": "n1",
      "type": "input",
      "name": "Latent Noise z_T",
      "position": {
        "x": 300,
        "y": 60
      },
      "params": {
        "shape": [
          1,
          4,
          32,
          32
        ]
      },
      "inputs": [],
      "outputs": [
        "n2"
      ]
    },
    {
      "id": "n2",
      "type": "custom",
      "name": "U-Net Denoiser",
      "scope": "diffusion",
      "position": {
        "x": 300,
        "y": 170
      },
      "params": {
        "type": "unet",
        "inChannels": 4,
        "modelChannels": 320,
        "attentionResolutions": [
          4,
          2,
          1
        ]
      },
      "inputs": [
        "n1"
      ],
      "outputs": [
        "n3"
      ]
    },
    {
      "id": "n3",
      "type": "custom",
      "name": "Denoised Latent z_0",
      "scope": "diffusion",
      "position": {
        "x": 300,
        "y": 280
      },
      "params": {
        "type": "denoised_latent"
      },
      "inputs": [
        "n2"
      ],
      "outputs": [
        "n4"
      ]
    },
    {
      "id": "n4",
      "type": "custom",
      "name": "VAE Decoder",
      "scope": "vae",
      "position": {
        "x": 300,
        "y": 390
      },
      "params": {
        "type": "vae_decoder",
        "inChannels": 4,
        "outChannels": 3
      },
      "inputs": [
        "n3"
      ],
      "outputs": [
        "n5"
      ]
    },
    {
      "id": "n5",
      "type": "output",
      "name": "Generated Image",
      "position": {
        "x": 300,
        "y": 500
      },
      "params": {},
      "inputs": [
        "n4"
      ],
      "outputs": []
    },
    {
      "id": "n6",
      "type": "input",
      "name": "Training Image",
      "position": {
        "x": 550,
        "y": 60
      },
      "params": {
        "shape": [
          1,
          3,
          256,
          256
        ]
      },
      "inputs": [],
      "outputs": [
        "n7"
      ]
    },
    {
      "id": "n7",
      "type": "custom",
      "name": "VAE Encoder",
      "scope": "vae",
      "position": {
        "x": 550,
        "y": 170
      },
      "params": {
        "type": "vae_encoder",
        "inChannels": 3,
        "outChannels": 4
      },
      "inputs": [
        "n6"
      ],
      "outputs": [
        "n8"
      ]
    },
    {
      "id": "n8",
      "type": "custom",
      "name": "Latent z",
      "scope": "vae",
      "position": {
        "x": 550,
        "y": 280
      },
      "params": {
        "type": "encoded_latent"
      },
      "inputs": [
        "n7"
      ],
      "outputs": [
        "n9"
      ]
    },
    {
      "id": "n9",
      "type": "custom",
      "name": "Add Noise",
      "scope": "diffusion",
      "position": {
        "x": 550,
        "y": 390
      },
      "params": {
        "type": "forward_diffusion",
        "steps": 1000
      },
      "inputs": [
        "n8"
      ],
      "outputs": [
        "n2"
      ]
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "n1",
      "to": "n2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "n2",
      "to": "n3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "n3",
      "to": "n4",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "n4",
      "to": "n5",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "n6",
      "to": "n7",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
      "from": "n7",
      "to": "n8",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c7",
      "from": "n8",
      "to": "n9",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c8",
      "from": "n9",
      "to": "n2",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}