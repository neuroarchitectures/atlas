    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Output",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {},
      "inputs": [
        "block-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "patch-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "patch-1",
      "to": "block-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
