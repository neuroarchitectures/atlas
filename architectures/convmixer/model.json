          3,
          224,
          224
        ]
      },
      "inputs": [],
      "outputs": [
        "patch-1"
      ]
    },
    {
      "id": "patch-1",
      "type": "conv",
      "name": "Patch Embed",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outChannels": 256,
        "kernelSize": 7,
        "stride": 7,
        "padding": 0,
        "inChannels": 3
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "block-1"
      ]
    },
    {
      "id": "block-1",
      "type": "conv",
      "name": "ConvMixer Block",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outChannels": 256,
        "kernelSize": 7,
        "stride": 1,
        "padding": 3,
