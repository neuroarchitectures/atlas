{
  "spec_version": "0.1",
  "id": "dueling-dqn",
  "name": "Dueling DQN",
  "description": "DQN with separate state value and advantage streams for better policy evaluation.",
  "category": "Reinforcement Learning",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Game Frame",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          4,
          84,
          84
        ]
      },
      "inputs": [],
      "outputs": [
        "conv-1"
      ]
    },
    {
      "id": "conv-1",
      "type": "conv2d",
      "name": "Conv 1",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 32
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "conv-2"
      ],
      "scope": "model"
    },
    {
      "id": "conv-2",
      "type": "conv2d",
      "name": "Conv 2",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 64
      },
      "inputs": [
        "conv-1"
      ],
      "outputs": [
        "conv-3"
      ],
      "scope": "model"
    },
    {
      "id": "conv-3",
      "type": "conv2d",
      "name": "Conv 3",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 512
      },
      "inputs": [
        "conv-2"
      ],
      "outputs": [
        "fc"
      ],
      "scope": "model"
    },
    {
      "id": "fc",
      "type": "linear",
      "name": "FC Layer",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "outFeatures": 512
      },
      "inputs": [
        "conv-3"
      ],
      "outputs": [
        "value"
      ],
      "scope": "model"
    },
    {
      "id": "value",
      "type": "linear",
      "name": "Value Stream V(s)",
      "position": {
        "x": 200,
        "y": 1050
      },
      "params": {
        "outFeatures": 1
      },
      "inputs": [
        "fc"
      ],
      "outputs": [
        "advantage"
      ],
      "scope": "model"
    },
    {
      "id": "advantage",
      "type": "linear",
      "name": "Advantage Stream A(s,a)",
      "position": {
        "x": 200,
        "y": 1250
      },
      "params": {
        "outFeatures": 18
      },
      "inputs": [
        "fc"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Q-values",
      "position": {
        "x": 200,
        "y": 1450
      },
      "params": {},
      "inputs": [
        "advantage"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "conv-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "conv-1",
      "to": "conv-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "conv-2",
      "to": "conv-3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "conv-3",
      "to": "fc",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-5",
      "from": "fc",
      "to": "value",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-6",
      "from": "fc",
      "to": "advantage",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-7",
      "from": "advantage",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}