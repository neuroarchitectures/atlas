{
  "spec_version": "0.1",
  "id": "videodepthanything",
  "name": "Video Depth Anything",
  "description": "Temporally consistent depth for super-long videos: spatial encoder from Depth Anything plus a lightweight temporal head and a temporal-consistency loss.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "n1",
      "type": "input",
      "name": "Video Frames (T frames)",
      "position": {
        "x": 220,
        "y": 60
      },
      "params": {},
      "inputs": [],
      "outputs": [
        "n2"
      ]
    },
    {
      "id": "n2",
      "type": "conv2d",
      "name": "DINOv2 Spatial Encoder (frozen / finetuned)",
      "position": {
        "x": 220,
        "y": 190
      },
      "params": {},
      "inputs": [
        "n1"
      ],
      "outputs": [
        "n3"
      ],
      "scope": "encoder"
    },
    {
      "id": "n3",
      "type": "attention",
      "name": "Temporal Attention Head (STA)",
      "position": {
        "x": 220,
        "y": 320
      },
      "params": {},
      "inputs": [
        "n2"
      ],
      "outputs": [
        "n4"
      ],
      "scope": "temporal"
    },
    {
      "id": "n4",
      "type": "custom",
      "name": "Temporal Consistency Loss",
      "position": {
        "x": 220,
        "y": 450
      },
      "params": {},
      "inputs": [
        "n3"
      ],
      "outputs": [
        "n5"
      ],
      "scope": "training"
    },
    {
      "id": "n5",
      "type": "custom",
      "name": "Key-Frame Inference (overlapping windows)",
      "position": {
        "x": 220,
        "y": 580
      },
      "params": {},
      "inputs": [
        "n4"
      ],
      "outputs": [
        "n6"
      ],
      "scope": "inference"
    },
    {
      "id": "n6",
      "type": "output",
      "name": "Temporally Consistent Depth Sequence",
      "position": {
        "x": 220,
        "y": 710
