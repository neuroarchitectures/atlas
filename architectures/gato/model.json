{
  "spec_version": "0.1",
  "id": "gato",
  "name": "Gato",
  "description": "DeepMind generalist agent: single transformer processes text, images, button presses, and continuous actions.",
  "category": "Multimodal",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Tokenized Multi-modal Input",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          2048
        ]
      },
      "inputs": [],
      "outputs": [
        "embed"
      ]
    },
    {
      "id": "embed",
      "type": "embedding",
      "name": "Token Embedding",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "vocabSize": 32000,
        "dim": 2048
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "decoder"
      ],
      "scope": "model"
    },
    {
      "id": "decoder",
      "type": "transformer-decoder",
      "name": "Transformer Decoder (24 layers)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "numLayers": 24,
        "hiddenSize": 2048,
        "numHeads": 16
      },
      "inputs": [
        "embed"
      ],
      "outputs": [
        "lm-head"
      ],
      "scope": "model"
    },
    {
      "id": "lm-head",
      "type": "linear",
      "name": "Output Head",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 32000
      },
      "inputs": [
        "decoder"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Action / Text Output",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {},
      "inputs": [
        "lm-head"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "embed",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "embed",
      "to": "decoder",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "decoder",
      "to": "lm-head",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "lm-head",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}