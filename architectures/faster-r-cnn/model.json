{
  "spec_version": "0.1",
  "id": "faster-r-cnn",
  "name": "Faster R-CNN",
  "description": "Faster R-CNN: end-to-end object detection with a Region Proposal Network (RPN) sharing features with the detection head.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "n1",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 300,
        "y": 60
      },
      "params": {
        "shape": [
          1,
          3,
          800,
          800
        ]
      },
      "inputs": [],
      "outputs": [
        "n2"
      ]
    },
    {
      "id": "n2",
      "type": "custom",
      "name": "Backbone CNN (ResNet)",
      "scope": "backbone",
      "position": {
        "x": 300,
        "y": 170
      },
      "params": {
        "type": "resnet50",
        "outChannels": 256
      },
      "inputs": [
        "n1"
      ],
      "outputs": [
        "n3",
        "n4"
      ]
    },
    {
      "id": "n3",
      "type": "custom",
      "name": "RPN 3x3 Conv",
      "scope": "rpn",
      "position": {
        "x": 200,
        "y": 290
      },
      "params": {
        "type": "rpn_conv",
        "outChannels": 256,
        "kernelSize": 3
      },
      "inputs": [
        "n2"
      ],
      "outputs": [
        "n5",
        "n6"
      ]
    },
    {
      "id": "n4",
      "type": "custom",
      "name": "RPN Cls (objectness)",
      "scope": "rpn",
      "position": {
        "x": 150,
        "y": 400
      },
      "params": {
        "type": "rpn_cls",
        "anchors": 9
      },
      "inputs": [
        "n3"
      ],
      "outputs": [
        "n7"
      ]
    },
    {
      "id": "n5",
      "type": "custom",
      "name": "RPN Reg (bbox)",
      "scope": "rpn",
      "position": {
        "x": 250,
        "y": 400
      },
      "params": {
        "type": "rpn_reg",
        "anchors": 9
      },
      "inputs": [
        "n3"
      ],
      "outputs": [
        "n8"
      ]
    },
    {
      "id": "n6",
      "type": "custom",
      "name": "Proposal Layer",
      "scope": "rpn",
      "position": {
        "x": 200,
        "y": 510
      },
      "params": {
        "type": "proposal",
        "nmsThreshold": 0.7,
        "preNmsTopN": 12000
      },
      "inputs": [
        "n4",
        "n5"
      ],
      "outputs": [
        "n9"
      ]
    },
    {
      "id": "n7",
      "type": "custom",
      "name": "RoI Pooling",
      "scope": "head",
      "position": {
        "x": 300,
        "y": 510
      },
      "params": {
        "type": "roi_align",
        "outputSize": 7
      },
      "inputs": [
        "n2",
        "n6"
      ],
      "outputs": [
        "n10"
      ]
    },
    {
      "id": "n8",
      "type": "linear",
      "name": "FC",
      "scope": "head",
      "position": {
        "x": 300,
        "y": 620
      },
      "params": {
        "outFeatures": 1024,
        "inFeatures": 25088
      },
      "inputs": [
        "n7"
      ],
      "outputs": [
        "n11"
      ]
    },
    {
      "id": "n9",
      "type": "linear",
      "name": "Cls (classes)",
      "scope": "head",
      "position": {
        "x": 250,
        "y": 730
      },
      "params": {
        "outFeatures": 81,
        "inFeatures": 1024
      },
      "inputs": [
        "n8"
      ],
      "outputs": [
        "n12"
      ]
    },
    {
      "id": "n10",
      "type": "linear",
      "name": "Reg (bbox)",
      "scope": "head",
      "position": {
        "x": 350,
        "y": 730
      },
      "params": {
        "outFeatures": 320,
        "inFeatures": 1024
      },
      "inputs": [
        "n8"
      ],
      "outputs": [
        "n13"
      ]
    },
    {
      "id": "n11",
      "type": "output",
      "name": "Detections",
      "position": {
        "x": 300,
        "y": 840
      },
      "params": {},
      "inputs": [
        "n9",
        "n10"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "n1",
      "to": "n2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "n2",
      "to": "n3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "n3",
      "to": "n4",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
