{
  "spec_version": "0.1",
  "id": "mlp-mixer",
  "name": "MLP-Mixer",
  "description": "Architecture for vision using only MLPs: mixing tokens and channels separately without attention or convolution.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Image Patches",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          196,
          256
        ]
      },
      "inputs": [],
      "outputs": [
        "norm-1"
      ]
    },
    {
      "id": "norm-1",
      "type": "layerNorm",
      "name": "LayerNorm",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "normalizedShape": 256
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "token-mix"
      ]
    },
    {
      "id": "token-mix",
      "type": "linear",
      "name": "Token-Mixing MLP",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 196,
        "inFeatures": 196
      },
      "inputs": [
        "norm-1"
      ],
      "outputs": [
        "gelu-1"
      ]
    },
    {
      "id": "gelu-1",
      "type": "gelu",
      "name": "GELU",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {},
      "inputs": [
        "token-mix"
      ],
      "outputs": [
        "add-1"
      ]
    },
    {
      "id": "add-1",
      "type": "add",
      "name": "Residual",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {},
      "inputs": [
        "gelu-1",
        "input-1"
      ],
      "outputs": [
        "norm-2"
      ]
    },
    {
      "id": "norm-2",
      "type": "layerNorm",
      "name": "LayerNorm 2",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 550
      },
      "params": {
        "normalizedShape": 256
      },
      "inputs": [
        "add-1"
      ],
      "outputs": [
        "channel-mix"
      ]
    },
    {
      "id": "channel-mix",
      "type": "linear",
      "name": "Channel-Mixing MLP",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 1024,
        "inFeatures": 256
      },
      "inputs": [
        "norm-2"
      ],
      "outputs": [
        "gelu-2"
      ]
    },
    {
      "id": "gelu-2",
      "type": "gelu",
      "name": "GELU 2",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 750
      },
      "params": {},
      "inputs": [
        "channel-mix"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Output",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {},
      "inputs": [
        "gelu-2"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "norm-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "norm-1",
      "to": "token-mix",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "token-mix",
      "to": "gelu-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "gelu-1",
      "to": "add-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "input-1",
      "to": "add-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
      "from": "add-1",
      "to": "norm-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c7",
      "from": "norm-2",
      "to": "channel-mix",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c8",
      "from": "channel-mix",
      "to": "gelu-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c9",
      "from": "gelu-2",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}