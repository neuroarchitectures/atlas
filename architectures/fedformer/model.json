{
  "spec_version": "0.1",
  "id": "fedformer",
  "name": "FEDformer",
  "description": "Frequency Enhanced Decomposed Transformer for long-term time series forecasting with Fourier and wavelet transforms.",
  "category": "Time Series",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Time Series",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          96,
          7
        ]
      },
      "inputs": [],
      "outputs": [
        "decomp-1"
      ]
    },
    {
      "id": "decomp-1",
      "type": "series-decomp",
      "name": "Trend-Seasonal Decomposition",
      "position": {
        "x": 200,
        "y": 200
      },
      "params": {},
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "fft-1"
      ],
      "scope": "model"
    },
    {
      "id": "fft-1",
      "type": "fft",
      "name": "Fourier Attention",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "numModes": 64
      },
      "inputs": [
        "decomp-1"
      ],
      "outputs": [
        "linear-1"
      ],
      "scope": "model"
    },
    {
      "id": "linear-1",
      "type": "linear",
      "name": "Frequency Linear",
      "position": {
        "x": 200,
        "y": 500
      },
      "params": {
        "outFeatures": 96,
        "inFeatures": 7
      },
      "inputs": [
        "fft-1"
      ],
      "outputs": [
        "decomp-2"
      ],
      "scope": "model"
    },
    {
      "id": "decomp-2",
      "type": "series-decomp",
      "name": "Final Decomposition",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {},
      "inputs": [
        "linear-1"
      ],
      "outputs": [
        "output-1"
      ],
      "scope": "model"
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Forecast",
      "position": {
        "x": 200,
        "y": 800
      },
      "params": {},
      "inputs": [
        "decomp-2"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "decomp-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "decomp-1",
      "to": "fft-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "fft-1",
      "to": "linear-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "linear-1",
      "to": "decomp-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "decomp-2",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}
