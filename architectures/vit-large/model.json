{
  "spec_version": "0.1",
  "id": "vit-large",
  "name": "ViT-Large",
  "description": "Large-scale Vision Transformer with 24 layers and 307M parameters for image classification.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          224,
          224
        ]
      },
      "inputs": [],
      "outputs": [
        "patch-1"
      ]
    },
    {
      "id": "patch-1",
      "type": "patchify",
      "name": "Patch Embedding",
      "position": {
        "x": 200,
        "y": 200
      },
      "params": {
        "patchSize": 16,
        "dim": 1024
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "pe-1"
      ],
      "scope": "model"
    },
    {
      "id": "pe-1",
      "type": "positional-encoding",
      "name": "Positional Encoding",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "type": "learned"
      },
      "inputs": [
        "patch-1"
      ],
      "outputs": [
        "tfmr-1"
      ],
      "scope": "model"
    },
    {
      "id": "tfmr-1",
      "type": "transformer",
      "name": "Transformer Encoder",
      "position": {
        "x": 200,
        "y": 500
      },
      "params": {
        "hiddenSize": 1024,
        "numHeads": 16,
        "numLayers": 24
      },
      "inputs": [
        "pe-1"
      ],
      "outputs": [
        "ln-1"
      ],
      "scope": "model"
    },
    {
      "id": "ln-1",
      "type": "layernorm",
      "name": "LayerNorm",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {},
      "inputs": [
        "tfmr-1"
      ],
      "outputs": [
        "linear-1"
      ],
      "scope": "model"
    },
    {
      "id": "linear-1",
      "type": "linear",
      "name": "Classifier",
      "position": {
        "x": 200,
        "y": 800
      },
      "params": {
        "outFeatures": 1000,
        "inFeatures": 1024
      },
      "inputs": [
        "ln-1"
      ],
      "outputs": [
        "output-1"
      ],
      "scope": "model"
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Class Logits",
      "position": {
        "x": 200,
        "y": 950
      },
      "params": {},
      "inputs": [
        "linear-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "patch-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "patch-1",
      "to": "pe-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "pe-1",
      "to": "tfmr-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "tfmr-1",
      "to": "ln-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "ln-1",
      "to": "linear-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
      "from": "linear-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}
