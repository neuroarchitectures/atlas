{
  "spec_version": "0.1",
  "id": "electra",
  "name": "ELECTRA",
  "description": "Efficiently Learning an Encoder that Classifies Token Replacements Accurately via replaced token detection.",
  "category": "NLP",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Token IDs",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          128
        ]
      },
      "inputs": [],
      "outputs": [
        "embed-1"
      ]
    },
    {
      "id": "embed-1",
      "type": "embedding",
      "name": "Token Embedding",
      "position": {
        "x": 200,
        "y": 200
      },
      "params": {
        "vocabSize": 30522,
        "dim": 256
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "tfmr-1"
      ],
      "scope": "model"
    },
    {
      "id": "tfmr-1",
      "type": "transformer",
      "name": "Generator",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "hiddenSize": 256,
        "numHeads": 4,
        "numLayers": 12
      },
      "inputs": [
        "embed-1"
      ],
      "outputs": [
        "tfmr-2"
      ],
      "scope": "model"
    },
    {
      "id": "tfmr-2",
      "type": "transformer",
      "name": "Discriminator",
      "position": {
        "x": 200,
        "y": 500
      },
      "params": {
        "hiddenSize": 768,
        "numHeads": 12,
        "numLayers": 12
      },
      "inputs": [
        "tfmr-1"
      ],
      "outputs": [
        "linear-1"
      ],
      "scope": "model"
    },
    {
      "id": "linear-1",
      "type": "linear",
      "name": "Binary Head",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 2,
        "inFeatures": 768
      },
      "inputs": [
        "tfmr-2"
      ],
      "outputs": [
        "output-1"
      ],
      "scope": "model"
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Replaced / Original",
      "position": {
        "x": 200,
        "y": 800
      },
      "params": {},
      "inputs": [
        "linear-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "embed-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "embed-1",
      "to": "tfmr-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "tfmr-1",
      "to": "tfmr-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "tfmr-2",
      "to": "linear-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "linear-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}
