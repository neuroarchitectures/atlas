{
  "spec_version": "0.1",
  "id": "capsule-network",
  "name": "Capsule Network",
  "description": "Network of capsules (vector-valued neurons) using dynamic routing-by-agreement instead of scalar neurons and max pooling.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          1,
          28,
          28
        ]
      },
      "inputs": [],
      "outputs": [
        "conv-1"
      ]
    },
    {
      "id": "conv-1",
      "type": "conv",
      "name": "Conv1",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outChannels": 256,
        "kernelSize": 9,
        "stride": 1,
        "padding": 0,
        "inChannels": 1
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "relu-1"
      ]
    },
    {
      "id": "relu-1",
      "type": "relu",
      "name": "ReLU",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {},
      "inputs": [
        "conv-1"
      ],
      "outputs": [
        "pcap-1"
      ]
    },
    {
      "id": "pcap-1",
      "type": "linear",
      "name": "Primary Capsules",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 256
      },
      "inputs": [
        "relu-1"
      ],
      "outputs": [
        "squash-1"
      ]
    },
    {
      "id": "squash-1",
      "type": "identity",
      "name": "Squash",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {},
      "inputs": [
        "pcap-1"
      ],
      "outputs": [
        "route-1"
      ]
    },
    {
      "id": "route-1",
      "type": "attention",
      "name": "Dynamic Routing",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 550
      },
      "params": {},
      "inputs": [
        "squash-1"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Digit Capsules",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {},
      "inputs": [
        "route-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "conv-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "conv-1",
      "to": "relu-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "relu-1",
      "to": "pcap-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "pcap-1",
      "to": "squash-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "squash-1",
      "to": "route-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
      "from": "route-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}