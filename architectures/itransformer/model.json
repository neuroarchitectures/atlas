      "type": "linear",
      "name": "Feed-Forward",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "outFeatures": 512,
        "inFeatures": 512
      },
      "inputs": [
        "attn-1"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Forecast",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {},
      "inputs": [
        "ffn-1"
      ],
      "outputs": []
