      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          96,
          8
        ]
      },
      "inputs": [],
      "outputs": [
        "embed-1"
      ]
    },
    {
      "id": "embed-1",
      "type": "linear",
      "name": "Variate Embedding",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outFeatures": 512,
        "inFeatures": 96
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "attn-1"
      ]
    },
    {
