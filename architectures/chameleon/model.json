{
  "spec_version": "0.1",
  "id": "chameleon",
  "name": "Chameleon",
  "description": "Meta early-fusion multimodal model: all modalities tokenized and processed as one sequence.",
  "category": "Multimodal",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Tokenized Multi-modal Input",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          4096
        ]
      },
      "inputs": [],
      "outputs": [
        "embed"
      ]
    },
    {
      "id": "embed",
      "type": "embedding",
      "name": "Token Embedding",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "vocabSize": 65536,
        "dim": 4096
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "decoder"
      ],
      "scope": "model"
    },
    {
      "id": "decoder",
      "type": "transformer-decoder",
      "name": "Transformer Decoder (32 layers)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "numLayers": 32,
        "hiddenSize": 4096,
        "numHeads": 32
      },
      "inputs": [
        "embed"
      ],
      "outputs": [
        "lm-head"
      ],
      "scope": "model"
    },
    {
      "id": "lm-head",
      "type": "linear",
      "name": "Output Head",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 65536
      },
      "inputs": [
        "decoder"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Multi-modal Output",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {},
      "inputs": [
        "lm-head"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "embed",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "embed",
      "to": "decoder",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "decoder",
      "to": "lm-head",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "lm-head",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}