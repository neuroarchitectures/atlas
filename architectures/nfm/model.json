{
  "spec_version": "0.1",
  "id": "nfm",
  "name": "NFM",
  "description": "Neural Factorization Machine: bi-interaction pooling layer + deep MLP for factorized feature interactions.",
  "category": "Recommendation",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Sparse Features",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          100
        ]
      },
      "inputs": [],
      "outputs": [
        "embedding"
      ]
    },
    {
      "id": "embedding",
      "type": "embedding",
      "name": "Embedding Layer",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "vocabSize": 1000,
        "dim": 16
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "bi-pool"
      ],
      "scope": "model"
    },
    {
      "id": "bi-pool",
      "type": "linear",
      "name": "Bi-Interaction Pooling",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 16
      },
      "inputs": [
        "embedding"
      ],
      "outputs": [
        "mlp"
      ],
      "scope": "model"
    },
    {
      "id": "mlp",
      "type": "linear",
      "name": "Deep MLP",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 1
      },
      "inputs": [
        "bi-pool"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Prediction",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {},
      "inputs": [
        "mlp"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "embedding",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "embedding",
      "to": "bi-pool",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "bi-pool",
      "to": "mlp",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "mlp",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}