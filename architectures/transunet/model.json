{
  "spec_version": "0.1",
  "id": "transunet",
  "name": "TransUNet",
  "description": "U-Net with ViT encoder for medical image segmentation: combines CNN local features with transformer global context.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          224,
          224
        ]
      },
      "inputs": [],
      "outputs": [
        "cnn-enc"
      ]
    },
    {
      "id": "cnn-enc",
      "type": "conv2d",
      "name": "CNN Encoder",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 512
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "vit-enc"
      ],
      "scope": "model"
    },
    {
      "id": "vit-enc",
      "type": "transformer-encoder",
      "name": "ViT Encoder",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "numLayers": 12,
        "hiddenSize": 768,
        "numHeads": 12
      },
      "inputs": [
        "cnn-enc"
      ],
      "outputs": [
        "decoder"
      ],
      "scope": "model"
    },
    {
      "id": "decoder",
      "type": "conv2d",
      "name": "U-Net Decoder",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 64
      },
      "inputs": [
        "vit-enc"
      ],
      "outputs": [
        "seg-head"
      ],
      "scope": "model"
    },
    {
      "id": "seg-head",
      "type": "conv2d",
      "name": "Segmentation Head",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "outFeatures": 4
      },
      "inputs": [
        "decoder"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Segmentation Map",
      "position": {
        "x": 200,
        "y": 1050
      },
      "params": {},
      "inputs": [
        "seg-head"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "cnn-enc",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "cnn-enc",
      "to": "vit-enc",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "vit-enc",
      "to": "decoder",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "decoder",
      "to": "seg-head",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-5",
      "from": "seg-head",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}