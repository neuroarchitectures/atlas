{
  "spec_version": "0.1",
  "id": "shufflenet-v1",
  "name": "ShuffleNet V1",
  "description": "Efficient CNN with pointwise group convolutions and channel shuffle for mobile.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          224,
          224
        ]
      },
      "inputs": [],
      "outputs": [
        "conv-1"
      ]
    },
    {
      "id": "conv-1",
      "type": "conv2d",
      "name": "Conv 1 (stride 2)",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 24
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "maxpool"
      ],
      "scope": "model"
    },
    {
      "id": "maxpool",
      "type": "maxpool2d",
      "name": "MaxPool (stride 2)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 24
      },
      "inputs": [
        "conv-1"
      ],
      "outputs": [
        "stage-2"
      ],
      "scope": "model"
    },
    {
      "id": "stage-2",
      "type": "conv2d",
      "name": "ShuffleNet Stage 2",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 232
      },
      "inputs": [
        "maxpool"
      ],
      "outputs": [
        "stage-3"
      ],
      "scope": "model"
    },
    {
      "id": "stage-3",
      "type": "conv2d",
      "name": "ShuffleNet Stage 3",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "outFeatures": 464
      },
      "inputs": [
        "stage-2"
      ],
      "outputs": [
        "stage-4"
      ],
      "scope": "model"
    },
    {
      "id": "stage-4",
      "type": "conv2d",
      "name": "ShuffleNet Stage 4",
      "position": {
        "x": 200,
        "y": 1050
