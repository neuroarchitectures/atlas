      "name": "FC Layer",
      "position": {
        "x": 200,
        "y": 1450
      },
      "params": {
        "outFeatures": 1000
      },
      "inputs": [
        "gap"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Class Logits",
      "position": {
        "x": 200,
        "y": 1650
      },
      "params": {},
      "inputs": [
        "fc"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "conv-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "conv-1",
      "to": "maxpool",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
