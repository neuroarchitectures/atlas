{
  "spec_version": "0.1",
  "id": "muzero",
  "name": "MuZero",
  "description": "Model-based RL: learns a latent dynamics model and plans with MCTS without knowing environment rules.",
  "category": "Reinforcement Learning",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Observation",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          96,
          96
        ]
      },
      "inputs": [],
      "outputs": [
        "rep-1"
      ]
    },
    {
      "id": "rep-1",
      "type": "linear",
      "name": "Representation",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 768
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "dyn-1"
      ]
    },
    {
      "id": "dyn-1",
      "type": "linear",
      "name": "Dynamics",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 256
      },
      "inputs": [
        "rep-1"
      ],
      "outputs": [
        "pred-1"
      ]
    },
    {
      "id": "pred-1",
      "type": "linear",
      "name": "Prediction",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 256
      },
      "inputs": [
        "dyn-1"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Policy + Value",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {},
      "inputs": [
        "pred-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "rep-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "rep-1",
      "to": "dyn-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "dyn-1",
      "to": "pred-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "pred-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}