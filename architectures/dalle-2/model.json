{
  "spec_version": "0.1",
  "id": "dalle-2",
  "name": "DALL-E 2",
  "description": "Text-to-image generation via CLIP image embeddings and prior + decoder diffusion models.",
  "category": "Generative",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Text Prompt",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          77
        ]
      },
      "inputs": [],
      "outputs": [
        "clip-text-1"
      ]
    },
    {
      "id": "clip-text-1",
      "type": "linear",
      "name": "CLIP Text Encoder",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outFeatures": 768,
        "inFeatures": 768
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "prior-1"
      ]
    },
    {
      "id": "prior-1",
      "type": "linear",
      "name": "Diffusion Prior",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 768,
        "inFeatures": 768
      },
      "inputs": [
        "clip-text-1"
      ],
      "outputs": [
        "dec-1"
      ]
    },
    {
      "id": "dec-1",
      "type": "conv2d",
      "name": "GLIDE Decoder",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "outFeatures": 3,
        "inFeatures": 768
      },
      "inputs": [
        "prior-1"
      ],
      "outputs": [
        "sr-1"
      ]
    },
    {
      "id": "sr-1",
      "type": "conv2d",
      "name": "Super-Resolution",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 3,
        "inFeatures": 3
      },
      "inputs": [
        "dec-1"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Generated Image",
      "position": {
        "x": 200,
        "y": 550
      },
      "params": {},
      "inputs": [
        "sr-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "clip-text-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "clip-text-1",
      "to": "prior-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "prior-1",
      "to": "dec-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "dec-1",
      "to": "sr-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "sr-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}