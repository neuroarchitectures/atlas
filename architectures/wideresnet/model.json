{
  "spec_version": "0.1",
  "id": "wideresnet",
  "name": "Wide ResNet",
  "description": "ResNet with wider channels (widen factor k) and fewer layers for efficient GPU training.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          32,
          32
        ]
      },
      "inputs": [],
      "outputs": [
        "conv-1"
      ]
    },
    {
      "id": "conv-1",
      "type": "conv2d",
      "name": "Conv 1 (3x3)",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 16
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "block-1"
      ],
      "scope": "model"
    },
    {
      "id": "block-1",
      "type": "conv2d",
      "name": "Wide ResBlock Stage 1",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 160
      },
      "inputs": [
        "conv-1"
      ],
      "outputs": [
        "block-2"
      ],
      "scope": "model"
    },
    {
      "id": "block-2",
      "type": "conv2d",
      "name": "Wide ResBlock Stage 2",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 320
      },
      "inputs": [
        "block-1"
      ],
      "outputs": [
        "block-3"
      ],
      "scope": "model"
    },
    {
      "id": "block-3",
      "type": "conv2d",
      "name": "Wide ResBlock Stage 3",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "outFeatures": 640
      },
      "inputs": [
        "block-2"
      ],
      "outputs": [
        "gap"
      ],
      "scope": "model"
    },
    {
      "id": "gap",
      "type": "adaptiveavgpool2d",
      "name": "Global Average Pool",
      "position": {
        "x": 200,
        "y": 1050
      },
      "params": {
        "outFeatures": 640
      },
      "inputs": [
        "block-3"
      ],
      "outputs": [
        "fc"
      ],
      "scope": "model"
    },
    {
      "id": "fc",
      "type": "linear",
      "name": "FC Layer",
      "position": {
        "x": 200,
        "y": 1250
      },
      "params": {
        "outFeatures": 10
      },
      "inputs": [
        "gap"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Class Logits",
      "position": {
        "x": 200,
        "y": 1450
      },
      "params": {},
      "inputs": [
        "fc"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "conv-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "conv-1",
      "to": "block-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "block-1",
      "to": "block-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "block-2",
      "to": "block-3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-5",
      "from": "block-3",
      "to": "gap",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-6",
      "from": "gap",
      "to": "fc",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-7",
      "from": "fc",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}