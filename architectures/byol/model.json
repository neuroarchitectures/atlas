        "target-enc"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "online-pred",
      "type": "linear",
      "name": "Predictor",
      "scope": "model",
      "position": {
        "x": 100,
        "y": 450
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 256
      },
