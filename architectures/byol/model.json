        "online-proj"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Stop-Grad Loss",
      "position": {
        "x": 200,
        "y": 550
      },
      "params": {},
      "inputs": [
        "online-pred",
        "target-proj"
      ],
      "outputs": []
    }
  ],
  "connections": [
