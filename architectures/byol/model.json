      "name": "Online Projector",
      "scope": "model",
      "position": {
        "x": 100,
        "y": 350
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 512
      },
      "inputs": [
        "online-enc"
      ],
      "outputs": [
        "online-pred"
      ]
    },
    {
      "id": "target-proj",
      "type": "linear",
      "name": "Target Projector (Momentum)",
      "scope": "model",
      "position": {
        "x": 300,
        "y": 350
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 512
