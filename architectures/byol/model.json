        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          224,
          224
        ]
      },
      "inputs": [],
      "outputs": [
        "aug-1",
        "aug-2"
      ]
    },
    {
      "id": "aug-1",
      "type": "conv",
      "name": "View 1",
      "scope": "model",
      "position": {
        "x": 100,
        "y": 150
      },
      "params": {
        "outChannels": 3,
        "kernelSize": 3,
        "stride": 1,
        "padding": 1,
        "inChannels": 3
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "online-enc"
      ]
    },
    {
      "id": "aug-2",
      "type": "conv",
      "name": "View 2",
      "scope": "model",
      "position": {
        "x": 300,
        "y": 150
      },
      "params": {
        "outChannels": 3,
        "kernelSize": 3,
        "stride": 1,
        "padding": 1,
        "inChannels": 3
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "target-enc"
      ]
    },
    {
      "id": "online-enc",
      "type": "linear",
      "name": "Online Encoder",
      "scope": "model",
      "position": {
        "x": 100,
        "y": 250
      },
      "params": {
        "outFeatures": 512,
        "inFeatures": 150528
      },
      "inputs": [
        "aug-1"
      ],
      "outputs": [
        "online-proj"
      ]
    },
    {
      "id": "target-enc",
      "type": "linear",
      "name": "Target Encoder (Momentum)",
      "scope": "model",
      "position": {
        "x": 300,
        "y": 250
      },
      "params": {
        "outFeatures": 512,
        "inFeatures": 150528
      },
