{
  "spec_version": "0.1",
  "id": "byol",
  "name": "BYOL",
  "description": "Bootstrap Your Own Latent: self-supervised learning without negative samples, using a stop-gradient and momentum-updated target network.",
  "category": "Computer Vision",
  "components": [
    {
