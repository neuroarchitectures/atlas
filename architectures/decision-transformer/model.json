      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outFeatures": 128,
        "inFeatures": 17
      },
      "inputs": [
        "input-2"
      ],
      "outputs": [
        "tf-1"
      ]
    },
    {
      "id": "embed-a",
