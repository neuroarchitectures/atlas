{
  "spec_version": "0.1",
  "id": "timemixer",
  "name": "TimeMixer",
  "description": "Multi-scale mixing architecture that decomposes time series into different temporal scales and uses MLPs for past-future and cross-scale mixing.",
  "category": "Time Series",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Input",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          96,
          1
        ]
      },
      "inputs": [],
      "outputs": [
        "scale-1",
        "scale-2",
        "scale-3"
      ]
    },
    {
      "id": "scale-1",
      "type": "identity",
      "name": "Scale 1 (raw)",
      "scope": "model",
      "position": {
        "x": 100,
        "y": 150
      },
      "params": {},
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "pfm-1"
      ]
    },
    {
      "id": "scale-2",
      "type": "identity",
      "name": "Scale 2 (downsample 2x)",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {},
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "pfm-2"
      ]
    },
    {
      "id": "scale-3",
      "type": "identity",
      "name": "Scale 3 (downsample 4x)",
      "scope": "model",
      "position": {
        "x": 300,
        "y": 150
      },
      "params": {},
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "pfm-3"
      ]
    },
    {
      "id": "pfm-1",
      "type": "linear",
      "name": "Past-Future Mix 1",
      "scope": "model",
      "position": {
        "x": 100,
        "y": 250
      },
      "params": {
        "outFeatures": 48,
        "inFeatures": 96
      },
      "inputs": [
        "scale-1"
      ],
      "outputs": [
        "csm-1"
      ]
    },
    {
      "id": "pfm-2",
      "type": "linear",
      "name": "Past-Future Mix 2",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 48,
        "inFeatures": 48
      },
      "inputs": [
        "scale-2"
      ],
      "outputs": [
        "csm-2"
      ]
    },
    {
      "id": "pfm-3",
      "type": "linear",
      "name": "Past-Future Mix 3",
      "scope": "model",
      "position": {
        "x": 300,
        "y": 250
      },
      "params": {
        "outFeatures": 48,
        "inFeatures": 24
      },
      "inputs": [
        "scale-3"
      ],
      "outputs": [
        "csm-3"
      ]
    },
    {
      "id": "csm-1",
      "type": "linear",
      "name": "Cross-Scale Mix",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
