{
  "spec_version": "0.1",
  "id": "albert",
  "name": "ALBERT",
  "description": "A Lite BERT: parameter-sharing transformer encoder with factorized embeddings for efficient pre-training.",
  "category": "NLP",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Token IDs",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          512
        ]
      },
      "inputs": [],
      "outputs": [
        "embed"
      ]
    },
    {
      "id": "embed",
      "type": "embedding",
      "name": "Factorized Embedding",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "vocabSize": 30000,
        "dim": 128
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "encoder"
      ],
      "scope": "model"
    },
    {
      "id": "encoder",
      "type": "transformer-encoder",
      "name": "Shared Transformer Encoder (12 layers)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "numLayers": 12,
        "hiddenSize": 768,
        "numHeads": 12
      },
      "inputs": [
        "embed"
      ],
      "outputs": [
        "pooler"
      ],
      "scope": "model"
    },
    {
      "id": "pooler",
      "type": "linear",
      "name": "Pooler",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 768
      },
      "inputs": [
        "encoder"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Pooled Output",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {},
      "inputs": [
        "pooler"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "embed",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "embed",
      "to": "encoder",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "encoder",
      "to": "pooler",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "pooler",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}