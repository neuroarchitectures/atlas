  "category": "NLP",
  "real_param_count": 7510000000,
  "block_templates": [
    {
      "id": "baichuan2_decoder_layer",
      "description": "Baichuan2 pre-norm transformer decoder layer: RMSNorm -> MHA -> residual add -> RMSNorm -> SwiGLU FFN -> residual add. The interface input x feeds attn_norm and the attention residual add (attn_residual); the attn_residual output feeds both ffn_norm and the FFN residual add (ffn_residual). numKVHeads equals numHeads: Baichuan2 uses full multi-head attention, not GQA.",
      "params": {
        "hiddenDim": {
          "type": "integer",
          "description": "Hidden dimension size"
        },
        "numHeads": {
          "type": "integer",
          "description": "Number of attention heads"
        },
        "numKVHeads": {
          "type": "integer",
          "description": "Number of key/value heads (equals numHeads in Baichuan2)"
        },
        "headDim": {
          "type": "integer",
          "description": "Dimension per attention head"
        },
        "intermediateSize": {
          "type": "integer",
          "description": "SwiGLU FFN intermediate dimension"
        }
      },
      "nodes": [
        {
          "id": "attn_norm",
          "type": "rmsNorm",
          "name": "RMSNorm",
          "params": {
            "normalizedShape": "$hiddenDim"
          }
        },
        {
          "id": "attention",
          "type": "groupedQueryAttention",
          "name": "Attention",
          "params": {
            "embedDim": "$hiddenDim",
            "numHeads": "$numHeads",
            "numKVHeads": "$numKVHeads",
            "headDim": "$headDim"
          }
        },
        {
          "id": "attn_residual",
          "type": "add",
          "name": "Add_attn",
          "params": {}
        },
        {
          "id": "ffn_norm",
          "type": "rmsNorm",
          "name": "RMSNorm",
          "params": {
            "normalizedShape": "$hiddenDim"
          }
        },
        {
          "id": "ffn",
          "type": "swiglu",
          "name": "FFN",
          "params": {
            "embedDim": "$hiddenDim",
            "dim": "$hiddenDim",
            "intermediateSize": "$intermediateSize"
          }
        },
        {
          "id": "ffn_residual",
          "type": "add",
          "name": "Add_ffn",
          "params": {}
        }
      ],
      "edges": [
        {
          "from": "attn_norm",
          "to": "attention"
        },
        {
          "from": "attention",
          "to": "attn_residual"
        },
        {
          "from": "attn_residual",
          "to": "ffn_norm"
        },
        {
          "from": "ffn_norm",
          "to": "ffn"
        },
        {
          "from": "ffn",
          "to": "ffn_residual"
        },
        {
          "from": "attn_residual",
          "to": "ffn_residual"
        }
      ],
      "interface": {
        "inputs": [
          {
            "name": "x",
            "description": "feeds attn_norm and attn_residual",
            "feeds": [
              "attn_norm",
              "attn_residual"
            ]
          }
        ],
        "outputs": [
          {
            "name": "y",
            "source_node": "ffn_residual",
            "description": "Layer output [batch, seq, 4096]"
          }
        ]
      }
    }
  ],
  "components": [
    {
      "id": "n1",
      "type": "input",
