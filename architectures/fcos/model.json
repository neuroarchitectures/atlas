{
  "spec_version": "0.1",
  "id": "fcos",
  "name": "FCOS",
  "description": "Fully Convolutional One-Stage Detector: anchor-free per-pixel prediction with center-ness branch.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          800,
          800
        ]
      },
      "inputs": [],
      "outputs": [
        "backbone"
      ]
    },
    {
      "id": "backbone",
      "type": "conv2d",
      "name": "ResNet Backbone",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 2048
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "fpn"
      ],
      "scope": "model"
    },
    {
      "id": "fpn",
      "type": "conv2d",
      "name": "Feature Pyramid Network",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "backbone"
      ],
      "outputs": [
        "cls-head"
      ],
      "scope": "model"
    },
    {
      "id": "cls-head",
      "type": "conv2d",
      "name": "Classification Head",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 80
      },
      "inputs": [
        "fpn"
      ],
      "outputs": [
        "reg-head"
      ],
      "scope": "model"
    },
    {
      "id": "reg-head",
      "type": "conv2d",
      "name": "Regression Head",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "outFeatures": 4
      },
      "inputs": [
        "cls-head"
      ],
      "outputs": [
        "centerness"
      ],
      "scope": "model"
    },
    {
      "id": "centerness",
      "type": "conv2d",
      "name": "Center-ness Head",
      "position": {
        "x": 200,
        "y": 1050
      },
      "params": {
        "outFeatures": 1
      },
      "inputs": [
        "reg-head"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Detections",
      "position": {
        "x": 200,
        "y": 1250
      },
      "params": {},
      "inputs": [
        "centerness"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "backbone",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "backbone",
      "to": "fpn",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "fpn",
      "to": "cls-head",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "cls-head",
      "to": "reg-head",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-5",
      "from": "reg-head",
      "to": "centerness",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-6",
      "from": "centerness",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}