        "patch-1"
      ],
      "outputs": [
        "enc-1"
      ]
    },
    {
      "id": "enc-1",
      "type": "linear",
      "name": "Transformer Encoder",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 256
      },
      "inputs": [
        "embed-1"
      ],
      "outputs": [
        "dec-1"
      ]
    },
    {
      "id": "dec-1",
      "type": "linear",
      "name": "Decoder",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 8,
        "inFeatures": 256
      },
      "inputs": [
        "enc-1"
      ],
      "outputs": [
        "output-1"
