      "type": "input",
      "name": "Multivariate Time Series",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          100,
          8
        ]
      },
      "inputs": [],
      "outputs": [
        "patch-1"
      ]
    },
    {
      "id": "patch-1",
      "type": "identity",
      "name": "Segment Patching",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {},
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "embed-1"
      ]
    },
    {
      "id": "embed-1",
      "type": "linear",
      "name": "Two-Stage Embedding",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 128
      },
