{
  "spec_version": "0.1",
  "id": "esmfold",
  "name": "ESMFold",
  "description": "Single-sequence protein structure prediction using a protein language model, no MSA needed.",
  "category": "Scientific",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Amino Acid Sequence",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          1024
        ]
      },
      "inputs": [],
      "outputs": [
        "plm-1"
      ]
    },
    {
      "id": "plm-1",
      "type": "linear",
      "name": "Protein LM",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outFeatures": 1280,
        "inFeatures": 1024
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "pair-1"
      ]
    },
    {
      "id": "pair-1",
      "type": "linear",
      "name": "Pair Feature",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 128,
        "inFeatures": 1280
      },
      "inputs": [
        "plm-1"
      ],
      "outputs": [
        "fold-1"
      ]
    },
    {
      "id": "fold-1",
      "type": "linear",
      "name": "Folding Trunk",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 256
      },
      "inputs": [
        "pair-1"
      ],
      "outputs": [
        "str-1"
      ]
    },
    {
      "id": "str-1",
      "type": "linear",
      "name": "Structure Module",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 256
      },
      "inputs": [
        "fold-1"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "3D Coordinates",
      "position": {
        "x": 200,
        "y": 550
      },
      "params": {},
      "inputs": [
        "str-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "plm-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "plm-1",
      "to": "pair-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "pair-1",
      "to": "fold-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "fold-1",
      "to": "str-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "str-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}