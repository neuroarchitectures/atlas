      "to": "expand-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "expand-1",
      "to": "flow-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
      "from": "flow-1",
      "to": "dec-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c7",
      "from": "dec-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
