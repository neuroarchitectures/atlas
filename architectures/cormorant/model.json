{
  "spec_version": "0.1",
  "id": "cormorant",
  "name": "Cormorant",
  "description": "COvariant Molecular Neural Network with Learned Attention: SE(3)-covariant attention for molecular energy.",
  "category": "Scientific",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Molecular Positions",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          100,
          3
        ]
      },
      "inputs": [],
      "outputs": [
        "embed"
      ]
    },
    {
      "id": "embed",
      "type": "embedding",
      "name": "Feature Embedding",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "vocabSize": 100,
        "dim": 64
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "attn"
      ],
      "scope": "model"
    },
    {
      "id": "attn",
      "type": "gnn",
      "name": "Covariant Attention Layers (4x)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "hiddenSize": 64
      },
      "inputs": [
        "embed"
      ],
      "outputs": [
        "pool"
      ],
      "scope": "model"
    },
    {
      "id": "pool",
      "type": "linear",
      "name": "Global Pooling",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 1
      },
      "inputs": [
        "attn"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Molecular Energy",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {},
      "inputs": [
        "pool"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "embed",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "embed",
      "to": "attn",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "attn",
      "to": "pool",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "pool",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}