{
  "spec_version": "0.1",
  "id": "infogan",
  "name": "InfoGAN",
  "description": "GAN with disentangled latent codes: maximizes mutual information between latent codes and generated data.",
  "category": "Generative",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Noise + Latent Code",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          110
        ]
      },
      "inputs": [],
      "outputs": [
        "gen"
      ]
    },
    {
      "id": "gen",
      "type": "conv2d",
      "name": "Generator",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 3
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "disc"
      ],
      "scope": "model"
    },
    {
      "id": "disc",
      "type": "conv2d",
      "name": "Discriminator",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 1
      },
      "inputs": [
        "gen"
      ],
      "outputs": [
        "q-net"
      ],
      "scope": "model"
    },
    {
      "id": "q-net",
      "type": "linear",
      "name": "Q Network (code recovery)",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 10
      },
      "inputs": [
        "disc"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Recovered Code",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {},
      "inputs": [
        "q-net"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "gen",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "gen",
      "to": "disc",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "disc",
      "to": "q-net",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "q-net",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}