{
  "spec_version": "0.1",
  "id": "informer",
  "name": "Informer",
  "description": "Efficient Transformer for long sequence time series forecasting using ProbSparse self-attention and generative-style decoding.",
  "category": "Time Series",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Input Sequence",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          96,
          8
        ]
      },
      "inputs": [],
      "outputs": [
        "embed-1"
      ]
    },
    {
      "id": "embed-1",
      "type": "embedding",
      "name": "Embedding",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "numEmbeddings": 1000,
        "embeddingDim": 512
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "attn-1"
      ]
    },
    {
      "id": "attn-1",
      "type": "attention",
      "name": "ProbSparse Attention",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {},
      "inputs": [
        "embed-1"
      ],
      "outputs": [
        "pool-1"
      ]
    },
    {
      "id": "pool-1",
      "type": "identity",
      "name": "Distilling (MaxPool)",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {},
      "inputs": [
        "attn-1"
      ],
      "outputs": [
        "attn-2"
      ]
    },
    {
      "id": "attn-2",
      "type": "attention",
      "name": "ProbSparse Attention 2",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {},
      "inputs": [
        "pool-1"
      ],
      "outputs": [
        "dec-1"
      ]
    },
    {
      "id": "dec-1",
      "type": "linear",
      "name": "Generative Decoder",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 550
      },
      "params": {
        "outFeatures": 24,
        "inFeatures": 512
      },
      "inputs": [
        "attn-2"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Forecast",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {},
      "inputs": [
        "dec-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "embed-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "embed-1",
      "to": "attn-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "attn-1",
      "to": "pool-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "pool-1",
      "to": "attn-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "attn-2",
      "to": "dec-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
      "from": "dec-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}