{
  "spec_version": "0.1",
  "id": "ssd",
  "name": "SSD",
  "description": "Single Shot MultiBox Detector: multi-scale single-stage detector with default boxes and feature pyramid.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          300,
          300
        ]
      },
      "inputs": [],
      "outputs": [
        "backbone"
      ]
    },
    {
      "id": "backbone",
      "type": "conv2d",
      "name": "VGG Backbone",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 512
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "fp-1"
      ],
      "scope": "model"
    },
    {
      "id": "fp-1",
      "type": "conv2d",
      "name": "Feature Map 1 (38x38)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 1024
      },
      "inputs": [
        "backbone"
      ],
      "outputs": [
        "fp-2"
      ],
      "scope": "model"
    },
    {
      "id": "fp-2",
      "type": "conv2d",
      "name": "Feature Map 2 (19x19)",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 512
      },
      "inputs": [
        "fp-1"
      ],
      "outputs": [
        "fp-3"
      ],
      "scope": "model"
    },
    {
      "id": "fp-3",
      "type": "conv2d",
      "name": "Feature Map 3 (10x10)",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "fp-2"
      ],
      "outputs": [
        "fp-4"
      ],
      "scope": "model"
    },
    {
      "id": "fp-4",
      "type": "conv2d",
      "name": "Feature Map 4 (5x5)",
      "position": {
        "x": 200,
        "y": 1050
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "fp-3"
      ],
      "outputs": [
        "fp-5"
      ],
      "scope": "model"
    },
    {
      "id": "fp-5",
      "type": "conv2d",
      "name": "Feature Map 5 (3x3)",
      "position": {
        "x": 200,
        "y": 1250
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "fp-4"
      ],
      "outputs": [
        "fp-6"
      ],
      "scope": "model"
    },
    {
      "id": "fp-6",
      "type": "conv2d",
      "name": "Feature Map 6 (1x1)",
      "position": {
        "x": 200,
        "y": 1450
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "fp-5"
      ],
      "outputs": [
        "detection"
      ],
      "scope": "model"
    },
    {
      "id": "detection",
      "type": "conv2d",
      "name": "Multi-scale Detection Head",
      "position": {
        "x": 200,
        "y": 1650
      },
      "params": {
        "outFeatures": 84
      },
      "inputs": [
        "fp-6"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Detections",
      "position": {
        "x": 200,
        "y": 1850
      },
      "params": {},
      "inputs": [
        "detection"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "backbone",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "backbone",
      "to": "fp-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "fp-1",
      "to": "fp-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "fp-2",
      "to": "fp-3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-5",
      "from": "fp-3",
      "to": "fp-4",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-6",
      "from": "fp-4",
      "to": "fp-5",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-7",
      "from": "fp-5",
      "to": "fp-6",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-8",
      "from": "fp-6",
      "to": "detection",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-9",
      "from": "detection",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}