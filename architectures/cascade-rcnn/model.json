{
  "spec_version": "0.1",
  "id": "cascade-rcnn",
  "name": "Cascade R-CNN",
  "description": "Multi-stage detector with cascaded bounding box heads at increasing IoU thresholds for high-quality detection.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          800,
          800
        ]
      },
      "inputs": [],
      "outputs": [
        "backbone"
      ]
    },
    {
      "id": "backbone",
      "type": "conv2d",
      "name": "ResNet Backbone",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 2048
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "fpn"
      ],
      "scope": "model"
    },
    {
      "id": "fpn",
      "type": "conv2d",
      "name": "Feature Pyramid Network",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "backbone"
      ],
      "outputs": [
        "rpn"
      ],
      "scope": "model"
    },
    {
      "id": "rpn",
      "type": "conv2d",
      "name": "Region Proposal Network",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "fpn"
      ],
      "outputs": [
        "roi-align"
      ],
      "scope": "model"
    },
    {
      "id": "roi-align",
      "type": "roialign",
      "name": "RoI Align",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "rpn"
      ],
      "outputs": [
        "bbox-head-1"
      ],
      "scope": "model"
    },
    {
      "id": "bbox-head-1",
      "type": "linear",
      "name": "BBox Head Stage 1 (IoU 0.5)",
      "position": {
        "x": 200,
        "y": 1050
      },
      "params": {
        "outFeatures": 1024
      },
      "inputs": [
        "roi-align"
      ],
      "outputs": [
        "bbox-head-2"
      ],
      "scope": "model"
    },
    {
      "id": "bbox-head-2",
      "type": "linear",
      "name": "BBox Head Stage 2 (IoU 0.6)",
      "position": {
        "x": 200,
        "y": 1250
      },
      "params": {
        "outFeatures": 1024
      },
      "inputs": [
        "bbox-head-1"
      ],
      "outputs": [
        "bbox-head-3"
      ],
      "scope": "model"
    },
    {
      "id": "bbox-head-3",
      "type": "linear",
      "name": "BBox Head Stage 3 (IoU 0.7)",
      "position": {
        "x": 200,
        "y": 1450
      },
      "params": {
        "outFeatures": 81
      },
      "inputs": [
        "bbox-head-2"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Detections",
      "position": {
        "x": 200,
        "y": 1650
      },
      "params": {},
      "inputs": [
        "bbox-head-3"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "backbone",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "backbone",
      "to": "fpn",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "fpn",
      "to": "rpn",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "rpn",
      "to": "roi-align",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-5",
      "from": "roi-align",
      "to": "bbox-head-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-6",
      "from": "bbox-head-1",
      "to": "bbox-head-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-7",
      "from": "bbox-head-2",
      "to": "bbox-head-3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-8",
      "from": "bbox-head-3",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}