      "to": "favor-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "favor-1",
      "to": "add-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "input-1",
      "to": "add-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
      "from": "add-1",
      "to": "norm-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
