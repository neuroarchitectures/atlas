        "disc-a"
      ],
      "outputs": []
    },
    {
      "id": "output-3",
      "type": "output",
      "name": "Reconstructed A",
      "position": {
        "x": 100,
        "y": 450
      },
      "params": {},
      "inputs": [
        "cyc-ba"
      ],
      "outputs": []
    },
    {
      "id": "output-4",
      "type": "output",
      "name": "Reconstructed B",
      "position": {
        "x": 400,
        "y": 450
      },
      "params": {},
      "inputs": [
        "cyc-ab"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
