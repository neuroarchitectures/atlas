      "to": "disc-a",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "gen-ab",
      "to": "cyc-ba",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
