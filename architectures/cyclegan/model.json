      "to": "gen-ab",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "input-b",
      "to": "gen-ba",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "gen-ab",
      "to": "disc-b",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
