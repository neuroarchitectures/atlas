{
  "spec_version": "0.1",
  "id": "pix2pix",
  "name": "Pix2Pix",
  "description": "Conditional GAN for image-to-image translation with U-Net generator and PatchGAN discriminator.",
  "category": "Generative",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Source Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          256,
          256
        ]
      },
      "inputs": [],
      "outputs": [
        "gen"
      ]
    },
    {
      "id": "gen",
      "type": "conv2d",
      "name": "U-Net Generator",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 3
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "disc"
      ],
      "scope": "model"
    },
    {
      "id": "disc",
      "type": "conv2d",
      "name": "PatchGAN Discriminator",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 1
      },
      "inputs": [
        "gen"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Adversarial Output",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {},
      "inputs": [
        "disc"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "gen",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "gen",
      "to": "disc",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "disc",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}