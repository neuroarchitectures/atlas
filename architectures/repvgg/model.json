{
  "spec_version": "0.1",
  "id": "repvgg",
  "name": "RepVGG",
  "description": "VGG-style CNN with re-parameterization: multi-branch training collapsed to single conv for fast inference.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          224,
          224
        ]
      },
      "inputs": [],
      "outputs": [
        "stage-1"
      ]
    },
    {
      "id": "stage-1",
      "type": "conv2d",
      "name": "Stage 1 (stride 2)",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 64
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "stage-2"
      ],
      "scope": "model"
    },
    {
      "id": "stage-2",
      "type": "conv2d",
      "name": "Stage 2 (stride 2)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 128
      },
      "inputs": [
        "stage-1"
      ],
      "outputs": [
        "stage-3"
      ],
      "scope": "model"
    },
    {
      "id": "stage-3",
      "type": "conv2d",
      "name": "Stage 3 (stride 2)",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 256
      },
      "inputs": [
        "stage-2"
      ],
      "outputs": [
        "stage-4"
      ],
      "scope": "model"
    },
    {
      "id": "stage-4",
      "type": "conv2d",
      "name": "Stage 4 (stride 2)",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "outFeatures": 512
      },
      "inputs": [
        "stage-3"
      ],
      "outputs": [
        "stage-5"
      ],
      "scope": "model"
    },
    {
      "id": "stage-5",
      "type": "conv2d",
      "name": "Stage 5 (stride 2)",
      "position": {
        "x": 200,
        "y": 1050
      },
      "params": {
        "outFeatures": 512
      },
      "inputs": [
        "stage-4"
      ],
      "outputs": [
        "gap"
      ],
      "scope": "model"
    },
    {
      "id": "gap",
      "type": "adaptiveavgpool2d",
      "name": "Global Average Pool",
      "position": {
        "x": 200,
        "y": 1250
      },
      "params": {
        "outFeatures": 512
      },
      "inputs": [
        "stage-5"
      ],
      "outputs": [
        "fc"
      ],
      "scope": "model"
    },
    {
      "id": "fc",
      "type": "linear",
      "name": "FC Layer",
      "position": {
        "x": 200,
        "y": 1450
      },
      "params": {
        "outFeatures": 1000
      },
      "inputs": [
        "gap"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Class Logits",
      "position": {
        "x": 200,
        "y": 1650
      },
      "params": {},
      "inputs": [
        "fc"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "stage-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "stage-1",
      "to": "stage-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "stage-2",
      "to": "stage-3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "stage-3",
      "to": "stage-4",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-5",
      "from": "stage-4",
      "to": "stage-5",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-6",
      "from": "stage-5",
      "to": "gap",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-7",
      "from": "gap",
      "to": "fc",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-8",
      "from": "fc",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
