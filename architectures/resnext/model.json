{
  "spec_version": "0.1",
  "id": "resnext",
  "name": "ResNeXt",
  "description": "ResNet variant with grouped convolutions following the cardinality principle: increasing the number of parallel paths (cardinality) improves accuracy.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Input",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          256,
          56,
          56
        ]
      },
      "inputs": [],
      "outputs": [
        "conv-1"
      ]
    },
    {
      "id": "conv-1",
      "type": "conv",
      "name": "1x1 Conv (reduce)",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outChannels": 128,
        "kernelSize": 1,
        "stride": 1,
        "padding": 0,
        "inChannels": 256
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "group-conv-1"
      ]
    },
    {
      "id": "group-conv-1",
      "type": "conv",
      "name": "3x3 GroupConv (32 groups)",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outChannels": 128,
        "kernelSize": 3,
        "stride": 1,
        "padding": 1,
        "inChannels": 128
      },
      "inputs": [
        "conv-1"
      ],
      "outputs": [
        "conv-2"
      ]
    },
    {
      "id": "conv-2",
      "type": "conv",
      "name": "1x1 Conv (expand)",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "outChannels": 256,
        "kernelSize": 1,
        "stride": 1,
        "padding": 0,
        "inChannels": 128
      },
      "inputs": [
        "group-conv-1"
      ],
      "outputs": [
        "add-1"
      ]
    },
    {
      "id": "add-1",
      "type": "add",
      "name": "Residual",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {},
      "inputs": [
        "conv-2",
        "input-1"
      ],
      "outputs": [
        "output-1"
      ]
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Output",
      "position": {
        "x": 200,
        "y": 550
      },
      "params": {},
      "inputs": [
        "add-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "conv-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "conv-1",
      "to": "group-conv-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "group-conv-1",
      "to": "conv-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "conv-2",
      "to": "add-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "input-1",
      "to": "add-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c6",
      "from": "add-1",
      "to": "output-1",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}