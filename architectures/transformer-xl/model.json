{
  "spec_version": "0.1",
  "id": "transformer-xl",
  "name": "Transformer-XL",
  "description": "Transformer with segment-level recurrence and relative positional encoding for long-context language modeling.",
  "category": "NLP",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Token IDs",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          512
        ]
      },
      "inputs": [],
      "outputs": [
        "embed"
      ]
    },
    {
      "id": "embed",
      "type": "embedding",
      "name": "Token Embedding",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "vocabSize": 32000,
        "dim": 1024
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "decoder"
      ],
      "scope": "model"
    },
    {
      "id": "decoder",
      "type": "transformer-decoder",
      "name": "Transformer-XL Decoder (18 layers, segment recurrence)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "numLayers": 18,
        "hiddenSize": 1024,
        "numHeads": 16
      },
      "inputs": [
        "embed"
      ],
      "outputs": [
        "lm-head"
      ],
      "scope": "model"
    },
    {
      "id": "lm-head",
      "type": "linear",
      "name": "LM Head",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "outFeatures": 32000
      },
      "inputs": [
        "decoder"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Output Logits",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {},
      "inputs": [
        "lm-head"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "embed",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "embed",
      "to": "decoder",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "decoder",
      "to": "lm-head",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "lm-head",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}