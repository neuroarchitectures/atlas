      "type": "conv2d",
      "name": "ResNet + FPN",
      "scope": "model",
      "position": {
        "x": 200,
        "y": 150
      },
      "params": {
        "outFeatures": 256,
        "inFeatures": 3
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
