      "outputs": [
        "ln-1"
      ],
      "scope": "model"
    },
    {
      "id": "ln-1",
      "type": "layernorm",
      "name": "LayerNorm",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {},
      "inputs": [
        "tfmr-1"
      ],
      "outputs": [
        "linear-1"
      ],
      "scope": "model"
    },
    {
      "id": "linear-1",
      "type": "linear",
      "name": "LM Head",
      "position": {
        "x": 200,
        "y": 800
      },
      "params": {
        "outFeatures": 50265,
        "inFeatures": 768
      },
      "inputs": [
        "ln-1"
      ],
      "outputs": [
        "output-1"
      ],
      "scope": "model"
    },
    {
      "id": "output-1",
      "type": "output",
      "name": "Token Probabilities",
      "position": {
        "x": 200,
        "y": 950
      },
      "params": {},
      "inputs": [
        "linear-1"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "input-1",
      "to": "embed-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "embed-1",
