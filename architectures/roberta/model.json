      "type": "transformer",
      "name": "Transformer Encoder",
      "position": {
        "x": 200,
        "y": 500
      },
      "params": {
        "hiddenSize": 768,
        "numHeads": 12,
        "numLayers": 24
      },
      "inputs": [
