{
  "spec_version": "0.1",
  "id": "roberta",
  "name": "RoBERTa",
  "description": "Robustly optimized BERT pre-training approach with dynamic masking, larger batches, and longer training.",
  "category": "NLP",
  "components": [
    {
      "id": "input-1",
      "type": "input",
      "name": "Token IDs",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          512
        ]
      },
      "inputs": [],
      "outputs": [
        "embed-1"
      ]
    },
    {
      "id": "embed-1",
      "type": "embedding",
      "name": "Token Embedding",
      "position": {
        "x": 200,
        "y": 200
      },
      "params": {
        "vocabSize": 50265,
        "dim": 768
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "pe-1"
      ],
      "scope": "model"
    },
    {
      "id": "pe-1",
      "type": "positional-encoding",
      "name": "Positional Encoding",
      "position": {
        "x": 200,
        "y": 350
      },
      "params": {
        "type": "learned",
        "maxLen": 512
