      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "pe-1",
      "to": "tfmr-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "tfmr-1",
      "to": "ln-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "ln-1",
      "to": "linear-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
