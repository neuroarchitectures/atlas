{
  "spec_version": "0.1",
  "id": "branchynet",
  "name": "BranchyNet",
  "description": "A network architecture where side branches are added to the main branch so samples can exit early: entropy of the prediction at each exit point measures confidence, and a confident sample exits without being processed by higher layers, cutting inference runtime and energy.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "n1",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 220,
        "y": 60
      },
      "params": {},
      "inputs": [],
      "outputs": [
        "n2"
      ]
    },
    {
      "id": "n2",
      "type": "custom",
      "name": "Main Branch (baseline network layers)",
      "position": {
        "x": 220,
        "y": 190
      },
      "params": {},
      "inputs": [
        "n1"
      ],
      "outputs": [
        "n3"
      ],
      "scope": "backbone"
    },
    {
      "id": "n3",
      "type": "custom",
      "name": "Side Branch Exit Point",
      "position": {
        "x": 220,
        "y": 320
      },
      "params": {},
      "inputs": [
        "n2"
      ],
      "outputs": [
        "n4"
      ],
      "scope": "backbone"
    },
    {
      "id": "n4",
      "type": "custom",
      "name": "Entropy-Based Confidence Threshold",
      "position": {
        "x": 220,
        "y": 450
      },
      "params": {},
      "inputs": [
        "n3"
      ],
      "outputs": [
        "n5"
      ],
      "scope": "inference"
    },
    {
      "id": "n5",
      "type": "custom",
      "name": "Joint Optimization over Weighted Exit Losses",
      "position": {
        "x": 220,
        "y": 580
      },
      "params": {},
      "inputs": [
        "n4"
      ],
      "outputs": [
        "n6"
      ],
      "scope": "training"
    },
    {
      "id": "n6",
      "type": "output",
      "name": "Early-Exit Prediction",
      "position": {
        "x": 220,
        "y": 710
      },
      "params": {},
      "inputs": [
        "n5"
      ],
      "outputs": []
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "n1",
      "to": "n2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c2",
      "from": "n2",
      "to": "n3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c3",
      "from": "n3",
      "to": "n4",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c4",
      "from": "n4",
      "to": "n5",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "c5",
      "from": "n5",
      "to": "n6",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}
