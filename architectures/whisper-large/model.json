{
  "spec_version": "0.1",
  "id": "whisper-large",
  "name": "Whisper Large",
  "description": "Multilingual speech recognition and translation model trained on 680K hours of weakly-supervised multilingual audio.",
  "category": "Audio",
  "components": [
