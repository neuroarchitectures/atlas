      "params": {
        "shape": [
          80,
          3000
        ]
      },
      "inputs": [],
      "outputs": [
        "conv-1"
      ]
    },
    {
      "id": "conv-1",
      "type": "conv1d",
      "name": "Conv1d",
      "position": {
        "x": 200,
        "y": 200
      },
      "params": {
        "outChannels": 1280,
        "kernelSize": 3,
        "stride": 1
      },
      "inputs": [
        "input-1"
      ],
      "outputs": [
        "conv-2"
      ],
      "scope": "model"
    },
    {
      "id": "conv-2",
      "type": "conv1d",
      "name": "Conv1d",
      "position": {
        "x": 200,
        "y": 350
