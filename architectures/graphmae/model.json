{
  "spec_version": "0.1",
  "id": "graphmae",
  "name": "GraphMAE",
  "description": "Masked autoencoder for graphs: reconstruct masked node features via GNN encoder-decoder.",
  "category": "Graph",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Graph Features",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          100,
          500
        ]
      },
      "inputs": [],
      "outputs": [
        "encoder"
      ]
    },
    {
      "id": "encoder",
      "type": "gnn",
      "name": "GNN Encoder",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "hiddenSize": 256
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "decoder"
      ],
      "scope": "model"
    },
    {
      "id": "decoder",
      "type": "gnn",
      "name": "GNN Decoder (reconstruction)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "hiddenSize": 500
      },
      "inputs": [
        "encoder"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Reconstructed Features",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {},
      "inputs": [
        "decoder"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "encoder",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "encoder",
      "to": "decoder",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "decoder",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
}