{
  "spec_version": "0.1",
  "id": "coatnet",
  "name": "CoAtNet",
  "description": "Hybrid CNN-Transformer: convolution stages with attention stages, combining inductive biases.",
  "category": "Computer Vision",
  "components": [
    {
      "id": "input",
      "type": "input",
      "name": "Image",
      "position": {
        "x": 200,
        "y": 50
      },
      "params": {
        "shape": [
          3,
          224,
          224
        ]
      },
      "inputs": [],
      "outputs": [
        "stage-1"
      ]
    },
    {
      "id": "stage-1",
      "type": "conv2d",
      "name": "Conv Stage 1 (MBConv)",
      "position": {
        "x": 200,
        "y": 250
      },
      "params": {
        "outFeatures": 64
      },
      "inputs": [
        "input"
      ],
      "outputs": [
        "stage-2"
      ],
      "scope": "model"
    },
    {
      "id": "stage-2",
      "type": "conv2d",
      "name": "Conv Stage 2 (MBConv)",
      "position": {
        "x": 200,
        "y": 450
      },
      "params": {
        "outFeatures": 96
      },
      "inputs": [
        "stage-1"
      ],
      "outputs": [
        "stage-3"
      ],
      "scope": "model"
    },
    {
      "id": "stage-3",
      "type": "transformer-encoder",
      "name": "Transformer Stage 1",
      "position": {
        "x": 200,
        "y": 650
      },
      "params": {
        "numLayers": 2,
        "hiddenSize": 192,
        "numHeads": 3
      },
      "inputs": [
        "stage-2"
      ],
      "outputs": [
        "stage-4"
      ],
      "scope": "model"
    },
    {
      "id": "stage-4",
      "type": "transformer-encoder",
      "name": "Transformer Stage 2",
      "position": {
        "x": 200,
        "y": 850
      },
      "params": {
        "numLayers": 12,
        "hiddenSize": 384,
        "numHeads": 6
      },
      "inputs": [
        "stage-3"
      ],
      "outputs": [
        "head"
      ],
      "scope": "model"
    },
    {
      "id": "head",
      "type": "linear",
      "name": "Classification Head",
      "position": {
        "x": 200,
        "y": 1050
      },
      "params": {
        "outFeatures": 1000
      },
      "inputs": [
        "stage-4"
      ],
      "outputs": [
        "output"
      ],
      "scope": "model"
    },
    {
      "id": "output",
      "type": "output",
      "name": "Class Logits",
      "position": {
        "x": 200,
        "y": 1250
      },
      "params": {},
      "inputs": [
        "head"
      ],
      "outputs": [],
      "scope": "model"
    }
  ],
  "connections": [
    {
      "id": "conn-1",
      "from": "input",
      "to": "stage-1",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-2",
      "from": "stage-1",
      "to": "stage-2",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-3",
      "from": "stage-2",
      "to": "stage-3",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-4",
      "from": "stage-3",
      "to": "stage-4",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-5",
      "from": "stage-4",
      "to": "head",
      "fromPort": "bottom",
      "toPort": "top"
    },
    {
      "id": "conn-6",
      "from": "head",
      "to": "output",
      "fromPort": "bottom",
      "toPort": "top"
    }
  ]
